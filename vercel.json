{
  "version": 2,
  "outputDirectory": "server/dist-web",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api",
      "dest": "/api/index.js"
    },
    {
      "src": "/((?!api/|.*\\.).*)",
      "dest": "/index.html"
    }
  ]
}
